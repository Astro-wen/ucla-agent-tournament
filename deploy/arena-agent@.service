# systemd USER unit template: one instance per agent key. Install with `scripts/run_agent.sh install-systemd`
# (fills in __ROOT__ = this checkout and __PATH__ = where node was found), then:
#   systemctl --user enable --now arena-agent@main          # main -> .env, arena-agent@NAME -> .env.NAME
#   sudo loginctl enable-linger $USER                       # run without a login session, start after a reboot
# scripts/run_agent.sh does the restarts, logs (logs/agent-NAME.out) and health lines; systemd restarts the loop
# itself if it ever dies. Stop = SIGTERM to the loop only (KillMode=mixed): it stops the agent tree cleanly and
# systemd SIGKILLs whatever is left after TimeoutStopSec.
# Put ALTRUAGENT_OFFICIAL_AGENT_KEY in the key file and the loop runs `python -m agent --tournament --match` (the
# key's test matches and tournament games, one process; mode=tournament(primary) on every health line).
[Unit]
Description=AltruAgent tournament agent (%i)
# (a user manager has no network-online.target; without network the agent just retries with backoff)
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=__ROOT__
ExecStart=/bin/bash __ROOT__/scripts/run_agent.sh run --name %i
Environment=PATH=__PATH__
Environment=PYTHONUNBUFFERED=1
Environment=HEALTH_EVERY=300
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=always
RestartSec=5
# One OOM kill must not stop the whole service (systemd's default OOMPolicy=stop would end every running match and
# restart everything): the node search / calculator processes, the kernel's preferred victims (agent/pokemon/calc.py
# prefer_for_oom_kill), are restarted by their worker, a killed worker by the supervisor, a killed agent by the loop.
OOMPolicy=continue
# 3 = this NAME already runs here (another loop of it holds its lock): retrying cannot help. (A second runtime of the
# same KEY under another NAME or LOG_DIR starts as a hot standby instead.)
# 2 = the start refused (no key, a malformed or retired key, an unwritable LOG_DIR, or the damage calculator /
# engine search cannot run; see the ERROR banner in the journal and in logs/agent-%i.out): retried every RestartSec,
# so it comes up by itself once that is fixed.
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
