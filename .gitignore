# Secrets — never commit
.env

# Leftover backup from an abnormally terminated scripts/smoke_game.py
# --concurrent run (it swaps agent/agent.py's contents temporarily and
# restores from this backup — see that script's own docstring).
agent/agent.py.smoke_test_backup

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Test / tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Match logs: only the real platform recordings of our two agents are kept in git
# (checked: no API keys, tokens or personal data); everything else in logs/ stays local.
logs/*
!logs/yoriko/
!logs/apocalypse/
.env.*
!.env.example

# agent worktrees
.claude/

# a bundled Node build (scripts/bundle.sh puts one in bundles; never commit the binary)
/node/

# per-version calculator links (see docs/HANDOFF.md, scripts/setup_machine.sh)
champion/agent/js/node_modules
versions/*/agent/js/node_modules
local/sparring/*/agent/js/node_modules
