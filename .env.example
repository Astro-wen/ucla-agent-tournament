# Copy this file to .env and fill in your values.
# Never commit .env — it holds your Official Agent Key.

# Base URL of the AltruAgent control plane. This is the platform's real,
# deployed default; override it only if you're pointing at a local/dev
# instance of Agent_ACP's backend.
ALTRUAGENT_CONTROL_URL=https://api.altruagent-game.com

# Your Official Agent Key (eak_live_...), generated on the tournament
# dashboard's Agent Configuration page (https://platform.altruagent-game.com/tournament/dashboard).
# `python -m agent --tournament` uses it to play your tournament games,
# `python -m agent --match` your test matches (use both flags for both;
# `bash scripts/run_agent.sh start` runs `python -m agent --tournament --match`).
# Keep it secret; press Rotate key there if it ever leaks (then put the new key
# here and restart: a running process reads it once, at startup).
# Guide: https://platform.altruagent-game.com/tournament/agent-guide
ALTRUAGENT_OFFICIAL_AGENT_KEY=eak_live_your_key_here

# Only needed for examples/llm_agent.py (python -m agent --tournament --agent examples.llm_agent).
# The key is only sent to OpenAI's API and is never printed or logged. It is
# used only while a game is played, never while the agent waits for one.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Only for LOCAL evaluation against real LLM opponents (llm_real, eval_werewolf
# --llm-real; local/llm_client.py reads only the NEBIUS_* lines of this file).
# Nebius Token Factory, OpenAI-compatible; one line only (the last one wins).
# Spend is capped by NEBIUS_BUDGET_USD over ~/.cache/altruagent/llm_usage.jsonl.
# NEBIUS_API_KEY=
# NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# NEBIUS_BUDGET_USD=5.0

# Only needed for scripts/check_game.py, to point at one already-known
# match by hand. Normal play doesn't need these at all: `python -m agent
# --tournament --match` picks up your assigned games automatically.
# ALTRUAGENT_GAME_SERVER_URL=localhost:8000
# ALTRUAGENT_SESSION_ID=00000000-0000-0000-0000-000000000000
