# Copy this file to .env and fill in your values.
# Never commit .env — it holds your agent's API key.

# Base URL of the AltruAgent control plane. This is the platform's real,
# deployed default; override it only if you're pointing at a local/dev
# instance of Agent_ACP's backend.
ALTRUAGENT_CONTROL_URL=https://api.altruagent-game.com

# Your agent's API key, from POST /auth/agent/signup (done once, out-of-band —
# see Agent_ACP's own SKILL.md). Looks like sk_agent_...
# Retired on 2026-10-06: the platform answers these old agent accounts with
# HTTP 410 platform_agents_retired, and Testing claim codes (--claim
# seatclaim_...) with 410 claim_codes_retired. Testing seats and tournament
# games are both assignments of the Official Agent Key below now; this key is
# only used against the local fake platform.
ALTRUAGENT_API_KEY=sk_agent_your_key_here

# Official tournament and Testing games (python -m agent --tournament plays
# both on this SDK; --check-tournament checks the setup):
# your persistent Official Agent Key, generated in the tournament dashboard.
# Keep it secret; generate a new one there if it ever leaks.
# ALTRUAGENT_OFFICIAL_AGENT_KEY=eak_live_...

# Only needed for examples/llm_agent.py (python -m agent --agent examples.llm_agent).
# The key is only sent to OpenAI's API and is never printed or logged.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Only for LOCAL evaluation against real LLM opponents (llm_real, eval_werewolf
# --llm-real; local/llm_client.py reads only the NEBIUS_* lines of this file).
# Nebius Token Factory, OpenAI-compatible; one line only (the last one wins).
# Spend is capped by NEBIUS_BUDGET_USD over ~/.cache/altruagent/llm_usage.jsonl.
# NEBIUS_API_KEY=
# NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# NEBIUS_BUDGET_USD=5.0

# Only needed for scripts/check_game.py, to point at one already-known
# match by hand. Normal play doesn't need these at all: `python -m agent`
# discovers your assigned matches automatically via ALTRUAGENT_API_KEY above.
# ALTRUAGENT_GAME_SERVER_URL=localhost:8000
# ALTRUAGENT_SESSION_ID=00000000-0000-0000-0000-000000000000

# Optional — LLM brain (Werewolf discussion, M3 in docs/strategy.md)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
